DATABASE_URL="postgresql://postgres:postgres@localhost:5432/audiencia?schema=public"
NEXTAUTH_SECRET="gere-uma-chave-secreta-aqui"
NEXTAUTH_URL="http://localhost:3000"
# Opcional: diretório para arquivos de vídeo (padrão: ./uploads na raiz do projeto)
# UPLOAD_DIR="/caminho/absoluto/para/uploads"

# Transcrição em lote (POST /api/gravacoes/:id/transcricao)
# Motor: whisper (padrão), wav2vec2 ou legal-whisper — ver AGENTS.md e requirements-transcription.txt
# LOCAL_TRANSCRIPTION_ENGINE="whisper"
# WHISPER_CPP_BIN="/caminho/absoluto/whisper-cli"
# WHISPER_MODEL_PATH="/caminho/absoluto/ggml-large-v3.bin"
# TRANSCRIPTION_PYTHON="python3"
# TRANSCRIPTION_WAV2VEC_SCRIPT="scripts/transcribe_wav2vec2.py"
# HF_MODEL_ID="jonatasgrosman/wav2vec2-large-xlsr-53-portuguese"
# HF_HOME="/caminho/para/cache/huggingface"
# Motor legal-whisper (Whisper-large-v3 + adapter PEFT especializado em audiências):
# IMPORTANTE: ao usar venv (.venv-transcription), aponte TRANSCRIPTION_PYTHON
# para o python ABSOLUTO do venv. O Next.js NÃO herda o venv do shell que
# iniciou o `npm run dev`; sem isso, o subprocess cai no python do sistema
# (sem peft) e a rota de transcrição retorna PYTHON_NOT_AVAILABLE / HTTP 500.
# TRANSCRIPTION_PYTHON="/caminho/abs/.venv-transcription/bin/python3"
# TRANSCRIPTION_LEGAL_WHISPER_SCRIPT="scripts/transcribe_legal_whisper.py"
# LEGAL_WHISPER_MODEL_ID="rhaymison/transcription-portuguese-legal-whisper-peft"
# LEGAL_WHISPER_BASE_MODEL_ID="openai/whisper-large-v3"
# Quantização 8-bit (apenas GPU CUDA + bitsandbytes); use "none" para forçar fp16/fp32:
# LEGAL_WHISPER_QUANT="8bit"
# Implementação de atenção do Whisper (sdpa requer PyTorch 2.1+); cai para "eager" automaticamente se incompatível:
# LEGAL_WHISPER_ATTN_IMPL="sdpa"
# Initial prompt (bias léxico) — sobrepõe o default jurídico:
# LEGAL_WHISPER_INITIAL_PROMPT="Audiência judicial. Magistrado, defesa, acusação, testemunha, depoimento."
# Equivalente para whisper.cpp (vazio = sem --prompt):
# WHISPER_INITIAL_PROMPT="Audiência judicial. Magistrado, defesa, acusação, testemunha, depoimento."

# Pré-processamento de áudio (FFmpeg)
# basic (DEFAULT): apenas conversão mono 16 kHz — recomendado pela OpenAI Cookbook.
#   Whisper foi treinado em áudio bruto/ruidoso; filtros agressivos costumam piorar o WER.
# loudness: two-pass loudnorm (-16 LUFS) sem filtros espectrais — útil quando há
#   locutores com volumes muito desiguais (juiz longe do mic vs. parte no mic).
# full: loudness + highpass 80Hz + lowpass 7800Hz — risco de degradar precisão; valide A/B antes.
# TRANSCRIPTION_AUDIO_PREPROCESS="basic"

# Pré-segmentação por VAD (Silero) antes da transcrição — reduz hallucinations em silêncio prolongado.
# Requer: pip install silero-vad
# TRANSCRIPTION_USE_VAD="1"
# TRANSCRIPTION_VAD_SCRIPT="scripts/preprocess_vad.py"
# Tunables (defaults: 250 / 500 / 80):
# VAD_MIN_SPEECH_MS="250"
# VAD_MIN_SILENCE_MS="500"
# VAD_PADDING_MS="80"

# Motor google (Speech-to-Text v2 + Chirp 2)
# Requer: GOOGLE_APPLICATION_CREDENTIALS apontando para JSON da Service Account com
# papéis "Speech-to-Text User" + "Storage Object Admin" no bucket de transcrição.
# A API faz upload do WAV para o bucket, executa batchRecognize e remove o blob ao final.
# LOCAL_TRANSCRIPTION_ENGINE="google"
# GOOGLE_APPLICATION_CREDENTIALS="/caminho/absoluto/sa.json"
# GCS_TRANSCRIPTION_BUCKET="audiencia-transcricoes"
# Região do recognizer/bucket — padrão us-central1 (Chirp 2 é estável aqui).
# southamerica-east1 nem sempre tem Chirp 2: confirme antes de mudar.
# GOOGLE_TRANSCRIPTION_REGION="us-central1"
# Modelo:
# - chirp_2 (default): SOTA multilíngue da Google para PT-BR. NÃO aceita
#   diarização nativa em batchRecognize.
# - chirp_3: aceita diarização nativa em batch e foi otimizado para
#   reuniões/depoimentos (multi-locutor). Use junto com
#   GOOGLE_TRANSCRIPTION_DIARIZATION_ENABLED=true.
# - latest_long: fallback para o modelo padrão v2.
# Refs: https://cloud.google.com/speech-to-text/v2/docs/chirp_2-model
#       https://docs.cloud.google.com/speech-to-text/docs/models/chirp-3
# GOOGLE_TRANSCRIPTION_MODEL="chirp_2"
# GOOGLE_TRANSCRIPTION_LANGUAGE="pt-BR"
# Diarização nativa: desligada por default. chirp_2 em batchRecognize não aceita
# diarizationConfig (API devolve INVALID_ARGUMENT que o gax às vezes mascara).
# A diarização do projeto baseada em voice features continua rodando.
# Habilite só se trocar o modelo para um que suporte (ex.: long_v3).
# GOOGLE_TRANSCRIPTION_DIARIZATION_ENABLED="false"
# GOOGLE_TRANSCRIPTION_DIARIZATION_MIN_SPEAKERS="2"
# GOOGLE_TRANSCRIPTION_DIARIZATION_MAX_SPEAKERS="6"

# Geração de Termo de Audiência (Maritaca AI)
# Header de auth é "Authorization: Key <chave>" (NÃO Bearer).
# Modelo recomendado: sabia-4 (128k contexto, structured output, corpus jurídico BR).
# MARITACA_API_KEY="..."
# MARITACA_MODEL="sabia-4"
# MARITACA_BASE_URL="https://chat.maritaca.ai/api"
